{
  "$schema": "https://typedoc-plugin-markdown.org/schema.json",
  "extends": [
    "./typedoc.json"
  ],
  "plugin": [
    "typedoc-plugin-markdown",
    "typedoc-vitepress-theme",
    "./scripts/typedoc-categories.mjs"
  ],
  "out": "docs/api",
  "docsRoot": "docs",
  "readme": "docs/api-index.md",
  "entryFileName": "index.md",
  "categorizeByGroup": false,
  "categoryOrder": [
    "Instance",
    "Options",
    "Data model",
    "Events",
    "Operations",
    "Datasets",
    "Snapping and tracing",
    "Styles",
    "Extension points",
    "Measure",
    "Create",
    "Combine",
    "Test",
    "Repair",
    "Bounds and units",
    "Types and errors",
    "Shaders and projection",
    "Blending and billboards",
    "Quads",
    "Lines",
    "Terrain",
    "Hit testing",
    "*"
  ],
  "groupOrder": [
    "Features",
    "Layers",
    "Groups",
    "Selection",
    "Vertices",
    "Modes",
    "Geometry",
    "Snapping and tracing",
    "Input",
    "Datasets",
    "Events",
    "Saving and loading",
    "Read-only and interaction lock",
    "Map and store",
    "Rendering",
    "Extending",
    "Lifecycle",
    "*"
  ],
  "navigation": {
    "includeCategories": true,
    "includeGroups": false
  },
  "hidePageHeader": true,
  "hideBreadcrumbs": true,
  "useCodeBlocks": true,
  "parametersFormat": "table",
  "interfacePropertiesFormat": "table",
  "classPropertiesFormat": "table",
  "typeAliasPropertiesFormat": "table",
  "enumMembersFormat": "table",
  "sidebar": {
    "autoConfiguration": true,
    "format": "vitepress",
    "pretty": true,
    "collapsed": true
  },
  "sanitizeComments": true
}
