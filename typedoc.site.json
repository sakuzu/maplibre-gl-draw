{
  "$schema": "https://typedoc-plugin-markdown.org/schema.json",
  "extends": [
    "./typedoc.json"
  ],
  "plugin": [
    "typedoc-plugin-markdown",
    "typedoc-vitepress-theme",
    "./scripts/typedoc-categories.mjs"
  ],
  "out": "docs/api",
  "docsRoot": "docs",
  "readme": "docs/api-index.md",
  "entryFileName": "index.md",
  "categorizeByGroup": false,
  "categoryOrder": [
    "Entry and options",
    "Writing",
    "Document model",
    "Inputs, patches and filters",
    "The stacking order of the items",
    "State",
    "Events",
    "Errors",
    "Datasets",
    "Store",
    "Extensions",
    "Style rule functions",
    "Color functions",
    "GeoJSON functions",
    "Parse functions",
    "Measure",
    "Create",
    "Combine",
    "Test",
    "Repair",
    "Bounds and units",
    "Types and errors",
    "Build a table",
    "Prepare in a Worker",
    "Pages of rows built or read in a Worker, for a Store that holds its features as rows",
    "Column types",
    "Pictures of points drawn with the rows",
    "Stores that hold features as rows",
    "The order of the rows",
    "Build and merge pages in a Worker",
    "Rows written as blocks named by their content, and their manifests (Tabane)",
    "What a plugin draws with, and what it holds on the GPU",
    "The rows of a layer read without making features",
    "Shaders and projection",
    "Blending and billboards",
    "Quads",
    "Lines",
    "Terrain",
    "Rows being dragged",
    "Hit testing",
    "Supporting types",
    "*"
  ],
  "groupOrder": [
    "Resources",
    "The map and the Store",
    "Mode",
    "Read-only and interaction lock",
    "Writing",
    "Events",
    "Drawing",
    "Lifecycle",
    "*"
  ],
  "navigation": {
    "includeCategories": true,
    "includeGroups": false
  },
  "hidePageHeader": true,
  "hideBreadcrumbs": true,
  "useCodeBlocks": true,
  "parametersFormat": "table",
  "interfacePropertiesFormat": "table",
  "classPropertiesFormat": "table",
  "typeAliasPropertiesFormat": "table",
  "enumMembersFormat": "table",
  "sidebar": {
    "autoConfiguration": true,
    "format": "vitepress",
    "pretty": true,
    "collapsed": true
  },
  "sanitizeComments": true
}
